# =============================================================================
# Cémantix Solver — Fichier de Configuration d'Environnement (.env.example)
# =============================================================================

# 1. Base de Données Relationnelle PostgreSQL (PostgreSQL 16/17 Alpine)
DB_HOST=cemantix_db
DB_PORT=5432
DB_NAME=cemantix
DB_USER=cemantix_user
DB_PASS=cemantix_secure_password_replace_in_prod

# 2. Paramètres Système et Fuseau Horaire
TZ=Europe/Paris
PYTHONUNBUFFERED=1

# 3. Fournisseur LLM Local (Optionnel — LM Studio, Ollama, vLLM)
LM_API=http://host.docker.internal:1234/v1
LLM_MODEL=qwen3.5-9b-claude-4.6-opus-reasoning-distilled-v2

# 4. Espace Vectoriel sémantique word2vec (frWac)
W2V_FILE=frWac_no_postag_phrase_500_cbow_cut10.bin
MAX_VOCAB=150000
