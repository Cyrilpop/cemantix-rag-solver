# =============================================================================
# Cémantix Solver — Fichier de Configuration d'Environnement (.env.example)
# =============================================================================

# 1. Base de Données Relationnelle PostgreSQL (PostgreSQL 16/17 Alpine)
DB_HOST=cemantix_db
DB_PORT=5432
DB_NAME=cemantix
DB_USER=cemantix_user
DB_PASS=cemantix_secure_password_replace_in_prod

# 2. Paramètres Système et Fuseau Horaire
TZ=Europe/Paris
PYTHONUNBUFFERED=1

# 3. Fournisseur LLM Local (Optionnel — LM Studio, Ollama, vLLM)
LM_API=http://host.docker.internal:1234/v1
LLM_MODEL=qwen3.5-9b-claude-4.6-opus-reasoning-distilled-v2

# 4. Espace Vectoriel sémantique word2vec (frWac)
W2V_FILE=frWac_no_postag_phrase_500_cbow_cut10.bin
MAX_VOCAB=150000

# 5. Variables lues par le code, optionnelles (défauts entre parenthèses)
#    Base :
#      DATABASE_URL      — chaîne complète, prioritaire sur DB_HOST/DB_PORT/… (non défini)
#      SQLITE_PATH       — chemin du repli local si PostgreSQL est absent (cemantix_data/cemantix.sqlite3)
#      DB_POOL_MAX       — connexions PostgreSQL simultanées (8)
#      DB_POOL_TIMEOUT   — secondes d'attente avant une erreur de pool saturé (10)
#      DB_CONN_MAX_IDLE  — secondes pendant lesquelles une connexion réutilisée est
#                          considérée valide sans vérification réseau (30)
#    Démon & tableau de bord :
#      DAEMON_HEARTBEAT_FILE      — battement partagé worker/web
#                                   (cemantix_data/daemon_heartbeat.json)
#      DAEMON_HEARTBEAT_INTERVAL  — secondes entre deux battements (15)
#      DASHBOARD_DATA_FILE        — payload du tableau de bord (cemantix_data/data.json)
#    Jeu :
#      DUEL_TOP_WORDS    — nombre de mots proposés en duel (10)
#      HISTORY_LIMIT     — résolutions chargées pour le tableau de bord (400) ;
#                          0 ou une valeur négative chargent tout l'historique
#    Défier le bot (docs/roadmap/2026-10-06-defier-le-bot) :
#      CHALLENGE_ENABLED        — "0" désactive la fonctionnalité : l'API répond
#                                 503 et le worker n'enlève plus rien (kill-switch)
#      CHALLENGE_QUOTA_PER_HOUR — défis par IP et par heure, persisté en base (10)
#      CHALLENGE_MAX_TRIES      — plafond de coups par défi, côté serveur (100)
#      CHALLENGE_TIMEOUT        — secondes max par résolution de défi (900)
#      CHALLENGE_MAX_QUEUE      — défis « queued » simultanés acceptés (20)
#      CHALLENGE_POLL_SECONDS   — intervalle de pick-up du worker (3)
#      CHALLENGE_RETENTION_DAYS — purge RGPD des défis plus vieux que N jours (30)
#      CHALLENGE_IP_SALT        — sel du HMAC d'IP ; à défaut, dérivation de DB_PASS.
#                                 Doit être un secret d'exploitation, jamais versionné.
#      SSE_MAX_STREAMS          — flux SSE « défi » simultanés dans le web (16)
#      SSE_STREAM_MAX_DURATION  — secondes max d'un flux SSE avant fermeture propre (900)
#
#    À ajouter quand ils seront implémentés : ALLOWED_ORIGINS et SECRET_KEY
#    (voir docs/roadmap/2026-10-securite-seo-performance/01-plan.md, SEC-03 et SEC-04).

# 5bis. Sécurité Réseau & Reverse Proxies (M3)
# -----------------------------------------------------------------------------
# Liste blanche d'adresses IP ou sous-réseaux CIDR de proxys de confiance autorisés
# à transmettre l'en-tête X-Forwarded-For.
# Par défaut vide (fail-closed) : si vide, l'en-tête X-Forwarded-For est ignoré
# et seule l'adresse TCP de connexion directe est utilisée pour le rate-limiting
# et les quotas.
# Exemple pour Caddy en local ou Docker bridge :
# TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
TRUSTED_PROXIES=

# 5ter. Mesure d'audience Google Tag Manager (GTM / GA4)
# -----------------------------------------------------------------------------
# Identifiant de conteneur Google Tag Manager (format GTM-XXXXXXXX).
# C'est un secret d'exploitation : il vit uniquement dans .env (jamais versionné,
# voir .gitignore). Le bloc de script déposé dans les pages HTML est un gabarit
# placeholder ; l'ID réel n'est substitué qu'au rendu HTTP par le conteneur
# (src/services/gtm.py + src/api/server.py). Variable vide = aucun suivi actif.
#
#   GOOGLE_TAG_MANAGER_ID  — ex. GTM-XXXXXXXX (vide par défaut : pas de suivi)
#
# NOTE : la console d'exploitation /panier-9x/ est volontairement exclue de tout
# suivi (page privée noindex), même lorsque la variable est renseignée.
GOOGLE_TAG_MANAGER_ID=

# 6. Console d'exploitation (hors index)
# -----------------------------------------------------------------------------
# La page /panier-9x/ et son API sont désactivées TANT QUE ADMIN_PASSWORD est
# vide : sans mot de passe, toutes les routes répondent 403.
#
#   ADMIN_PASSWORD    — Mot de passe de la console (obligatoire pour l'activer)
#   ADMIN_API_PATH    — Préfixe d'accès API (défaut: /api/snap-9x).
#                       Attention : modifier cette valeur nécessite de mettre à jour
#                       la balise <meta name="admin-api-path"> de volumes/web/panier-9x/index.html
#   ADMIN_TOKEN_TTL   — Durée de validité du jeton en secondes (défaut: 7200, soit 2h)
#   ADMIN_LOG_BUFFER  — Nombre de lignes de log conservées en mémoire vive (défaut: 800)
#
# NOTE SÉCURITÉ M3 : /var/run/docker.sock n'est plus monté dans le conteneur web.
# DOCKER_GID n'est plus requis en exploitation standard.
ADMIN_PASSWORD=
# ADMIN_API_PATH=/api/snap-9x
# ADMIN_TOKEN_TTL=7200
# ADMIN_LOG_BUFFER=800

# 7. Google Search Console & Soumission Sitemap (Jalon M10)
# -----------------------------------------------------------------------------
# Configuration OAuth 2.0 pour la soumission automatique de sitemap.xml à Search Console.
# Obtenez le GOOGLE_REFRESH_TOKEN via : docker compose run --rm cemantix --google-auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_REDIRECT_URIS=["https://cemantix.cyril-randon.fr"]

# 8. Protocole IndexNow (Bing, Yahoo, DuckDuckGo — Jalon M11)
# -----------------------------------------------------------------------------
# Clé API pour la notification d'indexation instantanée (optionnel).
# Si laissée vide, une clé aléatoire pérenne est générée et exposée sous volumes/web/<cle>.txt.
INDEXNOW_KEY=

# 9. Google Gemini API — Indices IA Sémantiques (Jalon M12)
# -----------------------------------------------------------------------------
# Clé d'API Google Gemini requise pour la génération des indices IA quotidiens (modèle gemini-3.8-flash)
GEMINI_API_KEY=




